# Copy this file to `.env` and fill in real values.
# `.env` is gitignored — do NOT commit your API key.

# YouTube Data API v3 key
# How to get one (5 min, free):
#   1. Go to https://console.cloud.google.com/
#   2. Create a project (or pick existing)
#   3. APIs & Services → Library → search "YouTube Data API v3" → Enable
#   4. APIs & Services → Credentials → Create Credentials → API Key
#   5. Copy the key (starts with "AIza...") and paste below
#
# Free quota: 10,000 units/day
#   - search.list  costs 100 units
#   - videos.list  costs 1 unit per call
#   → ~90 keyword searches/day before hitting limit
YOUTUBE_API_KEY=
